[sub_resource type="Resource" id="Resource_skeleton"]
script = ExtResource("2_entry")
id = &"basic_skeleton"
display_name = "Skeleton"
description = "Patrols the ground and chases anyone who enters its sight. It winds up a melee strike before attacking: step away when it raises its weapon."
portrait = ExtResource("3_skeleton")
max_health = 50.0
damage = 20.0
stardust_drop = 20
weakness = "Magic Arrow, which passes through walls"

[sub_resource type="Resource" id="Resource_crawler"]
script = ExtResource("2_entry")
id = &"platform_crawler"
display_name = "Platform Crawler"
description = "Circles a single platform and never leaves it. It only sees ahead: once it spots you, it speeds up and charges again and again."
placeholder_color = Color(0.55, 0.2, 0.75, 1)
max_health = 30.0
damage = 10.0
stardust_drop = 20
weakness = "Attacks from behind"

[sub_resource type="Resource" id="Resource_flying_eye"]
script = ExtResource("2_entry")
id = &"flying_eye"
display_name = "Flying Eye"
description = "A winged eyeball that drifts above the halls. Once it spots you, it keeps its distance and spits bolts from its pupil: watch it glow, then dodge."
portrait = ExtResource("4_flying_eye")
max_health = 40.0
damage = 10.0
stardust_drop = 20
weakness = "Walls block its sight and its bolts"

[sub_resource type="Resource" id="Resource_homunculus_couple"]
script = ExtResource("2_entry")
id = &"homunculus_couple"
display_name = "Homunculus Lovers"
description = "Two homunculi lost in a kiss. Step into their sight and they stare at you without letting go, then break apart and race after you, faster than they look. They will not stop until you leave their screen."
portrait = ExtResource("5_homunculus_couple")
max_health = 30.0
damage = 15.0
stardust_drop = 20
weakness = "Outrunning them off the screen"

[resource]
script = ExtResource("1_bestiary")
entries = Array[ExtResource("2_entry")]([SubResource("Resource_skeleton"), SubResource("Resource_crawler"), SubResource("Resource_flying_eye"), SubResource("Resource_homunculus_couple")])
